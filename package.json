{
  "name": "drillsat",
  "version": "1.2.0",
  "description": "Desktop SAT practice app with the official question bank, AI tutor and a built-in Desmos calculator",
  "main": "dist-electron/main.js",
  "private": true,
  "author": "DrillSAT",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "vite build && electron-builder --win",
    "dist:portable": "vite build && electron-builder --win portable",
    "bank:parse": "python tools/parse_pdf.py \"%MATH_PDF%\" data/pdf_math.json && python tools/parse_pdf.py \"%RW_PDF%\" data/pdf_rw.json",
    "bank:fetch": "python tools/fetch_bank.py data/math_list.json data/rw_list.json data/raw",
    "bank:build": "python tools/build_bank.py data/pdf_math.json data/pdf_rw.json data/raw data/bank"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  }
}
